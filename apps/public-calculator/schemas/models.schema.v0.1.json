{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cost-analysis.local/schema/models.schema.v0.1.json",
  "title": "Models Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "sources", "models"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "retrieved_at", "last_verified_at"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "last_verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source.schema.json" }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["provider", "model", "channels"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "channels": {
            "type": "array",
            "minItems": 0,
            "items": { "type": "string", "minLength": 1 }
          },
          "label": { "type": ["string", "null"] },
          "family": { "type": ["string", "null"] },
          "aliases": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1 }
          },
          "modalities": {
            "type": ["array", "null"],
            "items": { "type": "string", "minLength": 1 }
          },
          "ratings": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["system", "metric", "score", "as_of", "source_ids"],
              "properties": {
                "system": { "type": "string", "minLength": 1 },
                "metric": { "type": "string", "minLength": 1 },
                "score": { "type": "number" },
                "scale": { "type": ["string", "null"] },
                "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "source_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "notes": { "type": ["string", "null"] }
              }
            }
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}
