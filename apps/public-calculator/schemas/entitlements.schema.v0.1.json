{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cost-analysis.local/schema/entitlements.schema.v0.1.json",
  "title": "Entitlements Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "sources", "entitlements"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version_date"],
      "properties": {
        "version_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "target_region": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source.schema.json" }
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "provider_id",
          "plan_id",
          "region",
          "feature_id",
          "surface_id",
          "included",
          "evidence"
        ],
        "properties": {
          "provider_id": { "type": "string", "minLength": 1 },
          "product": { "type": ["string", "null"] },
          "plan_id": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "feature_id": { "type": "string", "minLength": 1 },
          "surface_id": { "type": "string", "minLength": 1 },
          "included": { "type": "boolean" },
          "limits": { "type": ["string", "null"] },
          "evidence": {
            "type": "object",
            "additionalProperties": true,
            "required": ["type", "source_ids"],
            "properties": {
              "type": { "type": "string", "minLength": 1 },
              "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          },
          "notes": { "type": ["string", "null"] }
        }
      }
    }
  }
}

