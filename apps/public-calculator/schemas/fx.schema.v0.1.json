{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cost-analysis.local/schema/fx.schema.v0.1.json",
  "title": "FX Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "sources", "rates"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "retrieved_at", "last_verified_at", "base_currency", "effective_date"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "last_verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "base_currency": { "type": "string", "minLength": 1 },
        "effective_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source.schema.json" }
    },
    "rates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
    }
  }
}

