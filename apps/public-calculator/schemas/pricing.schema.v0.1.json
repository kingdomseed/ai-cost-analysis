{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cost-analysis.local/schema/pricing.schema.v0.1.json",
  "title": "Pricing Snapshot v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "sources", "api_rates", "subscriptions", "tool_plans"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "retrieved_at", "last_verified_at", "default_currency"],
      "properties": {
        "schema_version": { "type": "string" },
        "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "last_verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "default_currency": { "type": "string", "minLength": 1 },
        "notes": { "type": ["string", "null"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source.schema.json" }
    },
    "api_rates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["provider", "channel", "model", "unit", "source_ids", "verified"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "channel": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "rates": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["name", "rates"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "applies_when": { "type": ["string", "null"] },
                "rates": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "number", "minimum": 0 }
                }
              }
            }
          },
          "regional_rates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["regions"],
              "properties": {
                "regions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                "input": { "type": "number", "minimum": 0 },
                "output": { "type": "number", "minimum": 0 },
                "notes": { "type": ["string", "null"] }
              }
            }
          },
          "notes": { "type": ["string", "null"] },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "verified": { "type": "boolean" }
        },
        "anyOf": [{ "required": ["rates"] }, { "required": ["tiers"] }, { "required": ["regional_rates"] }]
      }
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["provider", "plan_id", "source_ids", "verified"],
        "properties": {
          "provider": { "type": "string", "minLength": 1 },
          "product": { "type": ["string", "null"] },
          "plan_id": { "type": "string", "minLength": 1 },
          "price_usd_per_month": { "type": ["number", "null"], "minimum": 0 },
          "usage_limits": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "verified": { "type": "boolean" }
        }
      }
    },
    "tool_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["tool", "plan_id", "pricing_type", "source_ids", "verified"],
        "properties": {
          "tool": { "type": "string", "minLength": 1 },
          "plan_id": { "type": "string", "minLength": 1 },
          "pricing_type": { "type": "string", "minLength": 1 },
          "subscription_price_usd": { "type": ["number", "null"], "minimum": 0 },
          "subscription_price_usd_per_seat": { "type": ["number", "null"], "minimum": 0 },
          "included_pool_usd": { "type": ["number", "null"], "minimum": 0 },
          "credits_per_month": { "type": ["number", "null"], "minimum": 0 },
          "included_credits_per_month_per_seat": { "type": ["number", "null"], "minimum": 0 },
          "topups_pricing": { "type": ["object", "null"], "additionalProperties": true },
          "overage_policy": { "type": ["string", "null"] },
          "metering": { "type": ["string", "null"] },
          "availability_note": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "verified": { "type": "boolean" }
        }
      }
    }
  }
}
